generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Workspace {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  logo        String?
  ownerId     String
  billingPlan String             @default("ENTERPRISE")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  automations AutomationRule[]
  campaigns   Campaign[]
  clients     Client[]
  assets      DigitalAsset[]
  knowledge   KnowledgePage[]
  projects    Project[]
  published   PublishedContent[]
  sops        Sop[]
  tasks       Task[]
  members     WorkspaceMember[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        String    @default("MEMBER")
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  avatar           String?
  roles            String
  active           Boolean           @default(true)
  monthlyCapacity  Int               @default(12000)
  hourlyPoint      Int               @default(100)
  costPerPoint     Int               @default(250)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  activities       ActivityLog[]
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  notifications    Notification[]
  assignedSubtasks Subtask[]
  worklogs         Worklog[]
  workspaces       WorkspaceMember[]
}

model Client {
  id                 String                @id @default(uuid())
  name               String                @unique
  code               String                @unique
  monthlyPointBudget Int
  remainingPoint     Int
  usedPoint          Int                   @default(0)
  clientColor        String                @default("#3B82F6")
  logo               String?
  active             Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  workspaceId        String?
  notes              String?
  status             String                @default("Active")
  brandHub           BrandHub?
  campaigns          Campaign[]
  workspace          Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  budgets            ClientMonthlyBudget[]
  assets             DigitalAsset[]
  projects           Project[]
  publishedContent   PublishedContent[]
  tasks              Task[]
  worklogs           Worklog[]
}

model Campaign {
  id           String     @id @default(uuid())
  workspaceId  String?
  clientId     String
  name         String
  description  String?
  startDate    DateTime   @default(now())
  endDate      DateTime?
  budgetPoints Int        @default(5000)
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects     Project[]
  tasks        Task[]
}

model MasterScore {
  id        String   @id @default(uuid())
  category  String
  taskType  String
  format    String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySetting {
  id                        String   @id @default(uuid())
  effectiveWorkingHrs       Int      @default(6)
  workingDaysPerWeek        Int      @default(5)
  workdaysPerMonth          Int      @default(20)
  pointPerHour              Int      @default(100)
  monthlyCapacity           Int      @default(12000)
  costPerPoint              Int      @default(250)
  defaultDeadlineOffsetDays Int      @default(-3)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  archiveRule               String   @default("END_OF_MONTH")
  workStart                 String   @default("09:00")
  gracePeriod               Int      @default(15)
}

model ClientMonthlyBudget {
  id        String   @id @default(uuid())
  clientId  String
  month     String
  budget    Int
  used      Int
  remaining Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, month])
}

model Project {
  id          String     @id @default(uuid())
  name        String
  clientId    String
  description String?
  status      String     @default("Brief")
  priority    String     @default("Medium")
  totalScore  Int        @default(0)
  totalCOGS   Int        @default(0)
  startDate   DateTime   @default(now())
  endDate     DateTime?
  driveLink   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  campaignId  String?
  workspaceId String?
  campaign    Campaign?  @relation(fields: [campaignId], references: [id])
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {
  id               String              @id @default(uuid())
  projectId        String?
  clientId         String
  title            String
  description      String?
  category         String
  taskType         String?
  format           String?
  qty              Int                 @default(1)
  priority         String              @default("Medium")
  postingDate      DateTime?
  deadline         DateTime
  status           String              @default("Brief")
  assignedUserIds  String
  files            String?
  driveLink        String?
  previewLink      String?
  score            Int                 @default(0)
  cogs             Int                 @default(0)
  checklist        String?
  comments         String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  campaignId       String?
  workspaceId      String?
  stages           String?
  contentId        String              @default("")
  month            String              @default("July")
  year             Int                 @default(2026)
  archivedAt       DateTime?
  archivedBy       String?
  handoverTime     DateTime?
  handoverUserId   String?
  isArchived       Boolean             @default(false)
  workflowTimeline String?
  approvals        Approval[]
  recurringRules   RecurringTaskRule[]
  subtasks         Subtask[]
  campaign         Campaign?           @relation(fields: [campaignId], references: [id])
  client           Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project          Project?            @relation(fields: [projectId], references: [id])
  workspace        Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Subtask {
  id         String    @id @default(uuid())
  taskId     String
  title      String
  done       Boolean   @default(false)
  assigneeId String?
  deadline   DateTime?
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  assignee   User?     @relation(fields: [assigneeId], references: [id])
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model RecurringTaskRule {
  id           String   @id @default(uuid())
  taskId       String
  frequency    String   @default("MONTHLY")
  intervalDays Int      @default(30)
  nextRunDate  DateTime
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model BrandHub {
  id             String   @id @default(uuid())
  clientId       String   @unique
  guidelineDoc   String?
  primaryColor   String   @default("#3B82F6")
  secondaryColor String   @default("#8B5CF6")
  fonts          String?
  toneOfVoice    String?
  targetAudience String?
  dosAndDonts    String?
  moodboardUrls  String?
  driveFolder    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model DigitalAsset {
  id             String     @id @default(uuid())
  workspaceId    String?
  clientId       String
  folder         String     @default("Final")
  fileName       String
  fileUrl        String
  fileType       String
  fileSize       Int        @default(0)
  tags           String?
  collectionName String?
  version        Int        @default(1)
  createdAt      DateTime   @default(now())
  client         Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model PublishedContent {
  id               String     @id @default(uuid())
  workspaceId      String?
  clientId         String
  campaignId       String?
  platform         String     @default("INSTAGRAM")
  category         String?
  caption          String?
  hashtags         String?
  previewUrl       String?
  performanceScore Int        @default(100)
  publishedAt      DateTime   @default(now())
  client           Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workspace        Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Sop {
  id          String     @id @default(uuid())
  workspaceId String?
  department  String     @default("EDITOR")
  title       String
  content     String
  videoUrl    String?
  pdfUrl      String?
  checklist   String?
  version     Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model KnowledgePage {
  id          String          @id @default(uuid())
  workspaceId String?
  parentId    String?
  title       String
  content     String
  category    String          @default("General")
  tags        String?
  authorId    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  parent      KnowledgePage?  @relation("NestedKnowledge", fields: [parentId], references: [id])
  children    KnowledgePage[] @relation("NestedKnowledge")
  workspace   Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AutomationRule {
  id            String     @id @default(uuid())
  workspaceId   String?
  name          String
  triggerEvent  String
  actionsConfig String
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Worklog {
  id           String    @id @default(uuid())
  date         DateTime
  userId       String
  clientId     String
  contentTitle String
  taskType     String
  format       String
  qty          Int       @default(1)
  score        Int
  cogs         Int
  status       String    @default("Completed")
  source       String    @default("Manual")
  deadline     DateTime?
  previewLink  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  stages       String?
  contentId    String    @default("")
  month        String    @default("July")
  year         Int       @default(2026)
  archivedAt   DateTime?
  archivedBy   String?
  isArchived   Boolean   @default(false)
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attendance {
  id             String    @id @default(uuid())
  userId         String
  date           DateTime  @default(now())
  clockIn        DateTime
  clockOut       DateTime?
  locationMode   String    @default("OFFICE")
  status         String    @default("ACTIVE")
  workingHours   Float     @default(0.0)
  workingMinutes Int       @default(0)
  isLate         Boolean   @default(false)
  lateMinutes    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id               String   @id @default(uuid())
  userId           String
  startDate        DateTime
  endDate          DateTime
  reason           String
  type             String   @default("ANNUAL")
  status           String   @default("PENDING")
  approvedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Approval {
  id                String   @id @default(uuid())
  taskId            String
  stage             String   @default("STRATEGIST")
  status            String   @default("PENDING")
  requestedByUserId String
  reviewedByUserId  String?
  revisionNotes     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  task              Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  entityType String
  entityId   String
  action     String
  details    String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
